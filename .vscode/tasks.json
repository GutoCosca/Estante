{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Subir servidor do projeto",
            "type": "shell",
            "command": "docker compose up -d --build --wait",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": [],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "Parar servidor do projeto",
            "type": "shell",
            "command": "docker compose down",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ]
}
